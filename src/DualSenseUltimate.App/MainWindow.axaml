<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DualSenseUltimate.App.MainWindow"
        Title="DualSense Ultimate" Icon="/Assets/icon.ico"
        Width="1320" Height="860" MinWidth="980" MinHeight="620"
        Background="{DynamicResource AppBg}" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="236,*">
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,18" Spacing="11">
          <Border Width="36" Height="36" CornerRadius="10" ClipToBounds="True"><Image Source="/Assets/icon.png"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DualSense" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="ULTIMATE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" LetterSpacing="3"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16">
          <TextBlock x:Name="StatusText" Classes="muted"/>
          <TextBlock x:Name="VersionText" Classes="muted" Opacity="0.7"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ListBox x:Name="Nav" Classes="nav" SelectionChanged="NavChanged"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="28,18,28,10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock x:Name="PageTitle" Classes="h1"/>
            <TextBlock x:Name="PageSubtitle" Classes="muted" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="UpdateBadge" Classes="accent" IsVisible="False" Click="OpenUpdates" Padding="10,4" FontSize="12"/>
            <Border Classes="pill" x:Name="SimBadge" Background="#33FFB020" IsVisible="False">
              <TextBlock Text="MANDO SIMULADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
            </Border>
            <Border Classes="pill"><TextBlock x:Name="ProfileBadge" FontSize="12"/></Border>
            <ComboBox x:Name="ControllerPicker" Width="250" PlaceholderText="Sin mandos conectados" SelectionChanged="ControllerPicked"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="ConflictBar" DockPanel.Dock="Top" Classes="notice" Margin="28,0,28,8" IsVisible="False">
        <TextBlock x:Name="ConflictText" TextWrapping="Wrap" FontSize="12.5"/>
      </Border>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <TransitioningContentControl x:Name="PageHost" Margin="28,6,14,20"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
