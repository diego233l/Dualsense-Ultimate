<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DualSenseUltimate</AssemblyName>
    <RootNamespace>DualSenseUltimate.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.23" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DualSenseUltimate.Core\DualSenseUltimate.Core.csproj" />
    <ProjectReference Include="..\DualSenseUltimate.Platform\DualSenseUltimate.Platform.csproj" />
    <ProjectReference Include="..\DualSenseUltimate.Api\DualSenseUltimate.Api.csproj" />
  </ItemGroup>
</Project>
